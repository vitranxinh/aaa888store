# On Vercel + Neon:
# - DATABASE_URL should use the pooled runtime URL (-pooler)
# - DIRECT_URL should use the direct non-pooled URL for Prisma migrate / db push
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soban_retail?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/soban_retail?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret"
APP_URL="http://localhost:3000"
SEED_ADMIN_EMAIL="admin@soban.vn"
SEED_ADMIN_PASSWORD="12345678"
